{
  "name": "nexus-messenger",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "Nexus Messenger — адаптивный веб-мессенджер с текстовым общением и аудио/видеозвонками через WebRTC",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc -b --pretty false",
    "check": "npm run build && npm test",
    "pages:sync": "node scripts/sync-pages.mjs",
    "test:browser": "playwright test",
    "test:integration": "vitest run tests/live.integration.test.ts"
  },
  "dependencies": {
    "@supabase/supabase-js": "2.119.0",
    "lucide-react": "^0.441.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^7.18.5",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@playwright/test": "1.58.2",
    "@types/node": "^22.20.5",
    "@types/react": "^18.3.5",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "autoprefixer": "^10.4.20",
    "postcss": "^8.4.45",
    "tailwindcss": "^3.4.10",
    "typescript": "^5.5.4",
    "vite": "^8.3.8",
    "vitest": "^5.1.1"
  },
  "engines": {
    "node": ">=22.12.0"
  }
}
